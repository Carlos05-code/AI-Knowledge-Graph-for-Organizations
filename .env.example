# =============================================================================
# AI Knowledge Graph — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Application ---
NODE_ENV=development
APP_NAME=AI Knowledge Graph
APP_PORT=3000
APP_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# --- Authentication (Keycloak) ---
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ai-knowledge-graph
KEYCLOAK_CLIENT_ID=backend
KEYCLOAK_CLIENT_SECRET=your-client-secret
# Optional: override JWKS endpoint (default: ${issuer}/protocol/openid-connect/certs).
KEYCLOAK_JWKS_URL=
# Optional: organization id new SSO users are provisioned into (else a new org is created).
KEYCLOAK_DEFAULT_ORG_ID=

# --- JWT ---
JWT_SECRET=your-jwt-secret-min-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=ai_knowledge_graph

# --- Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j-password

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# --- OpenSearch ---
OPENSEARCH_HOST=http://localhost:9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=admin

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- MinIO ---
MINIO_HOST=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=knowledge-graph

# --- AI / LLM ---
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

# --- Logging ---
LOG_LEVEL=debug
LOG_FORMAT=json

# --- Database ---
# Runtime connections (API -> PgBouncer). Use the direct postgres URL for prisma migrate.
DATABASE_URL=postgresql://postgres:postgres@localhost:6432/ai_knowledge_graph?connection_limit=9&pool_timeout=10&pgbouncer=true
# Prisma queries slower than this (ms) are logged as warnings; 0 disables.
SLOW_QUERY_MS=500

# --- Monitoring ---
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true

# --- Rate Limiting ---
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# --- Encryption ---
ENCRYPTION_KEY=your-32-byte-encryption-key-here
# Comma-separated PREVIOUS keys (oldest first), used ONLY for decryption of
# older ciphertext versions (payloads tagged `akg:v{N}:`). Leave empty on first setup.
# Rotate procedure: move the current key here, set a new key above, restart all instances.
ENCRYPTION_KEYS=

# --- OCR ---
# Language(s) for tesseract; comma-separated packs become `eng+spa` style.
OCR_LANGUAGE=eng
# Minimum recognition confidence (0-100) to accept a page/result; 0 = accept everything.
OCR_MIN_CONFIDENCE=0
# Cap on PDF pages OCR'd per document (scanned PDFs).
OCR_MAX_PAGES=50

# --- SMTP (invitation/outbound mail) ---
MAIL_ENABLED=true
# Log-only fallback (no delivery) when SMTP_HOST is unset or delivery fails.
SMTP_HOST=
SMTP_PORT=587
# Implicit TLS on connect (true for port 465).
SMTP_SECURE=false
# Require STARTTLS upgrade (opportunistic TLS enforcement).
SMTP_REQUIRE_TLS=false
# Set to false to accept self-signed certificates (dev only).
SMTP_REJECT_UNAUTHORIZED=true
# Retry attempts on transient SMTP failures (total attempts = 1 + retries).
SMTP_RETRIES=2
# Base delay between retries (ms); multiplied by attempt number.
SMTP_RETRY_DELAY_MS=1000
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AI Knowledge Graph <noreply@localhost>
FRONTEND_URL=http://localhost:4200
